# ==================================================================
# Ejadah HR AI Assistant - configuration
#
# Copy to .env and fill in. Do NOT commit .env.
# ==================================================================


# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------

# local | staging | production
# 'production' refuses to start on an unsafe configuration.
ENVIRONMENT=production

# Verbose logging. Logs questions, answers and employee records, so
# it is REFUSED when ENVIRONMENT=production.
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Keep at 1. The rate limiter and the token cache are per process;
# more workers means the limits multiply and identity caching stops
# being shared.
WORKERS=1

LOG_LEVEL=INFO
LOG_FILE=logs/app.log


# ------------------------------------------------------------------
# HTTP surface
# ------------------------------------------------------------------

# Comma-separated. The mobile app is not a browser so CORS never
# applies to it; these are for a web build or local tooling.
# '*' is refused in production.
CORS_ALLOW_ORIGINS=https://oneapp.ejadah.ae

SOCKET_CORS_ALLOW_ORIGINS=https://oneapp.ejadah.ae

# The public hostname(s) this service answers on. '*' is refused in
# production.
ALLOWED_HOSTS=chat.ejadah.ae


# ------------------------------------------------------------------
# Ejadah HR API - identity and employee data
# ------------------------------------------------------------------

# Must match `api_base_url` in the Flutter app's
# lib/src/config/ejadhaconfig.dart, and must end with a slash.
#
#   staging : https://ej-staging.usis.in:3583/fusiondev/api/
#   live    : https://oneapp.ejadah.ae/external/api/
EJADAH_API_BASE_URL=https://oneapp.ejadah.ae/external/api/

EJADAH_API_TIMEOUT_SECONDS=20
EJADAH_API_MAX_RETRIES=2

# Certificate validation. Leave true. Only set false against a
# staging host with a broken chain - it is refused in production.
EJADAH_VERIFY_SSL=true

# The Ejadah gateway needs unsafe legacy TLS renegotiation; the
# Flutter app sets the same flag in main.dart. Without this, OpenSSL
# 3 fails every handshake.
EJADAH_ALLOW_LEGACY_TLS_RENEGOTIATION=true

# OPTIONAL but strongly recommended - see the "Residual risk" note
# in ejadah/identity_service.py.
#
# The name of an Ejadah route that resolves the caller from the
# bearer token ALONE (empty request body) and returns the owning
# employee number. Setting this makes identity verification exact
# rather than an echo check. Leave empty until such a route exists.
EJADAH_IDENTITY_ROUTE=

# Where to look for the employee number in that route's Response.
EJADAH_IDENTITY_RESPONSE_KEYS=EmployeeNumber,EMPLOYEENUMBER,EmployeeId,EMPLOYEEID

# How long a verified token -> employee binding is trusted before
# Ejadah is asked again. Lower means revocation takes effect sooner
# and costs more upstream calls.
IDENTITY_CACHE_TTL_SECONDS=300

# How long one employee's HR data is cached. Keep short: leave
# approvals happen during the working day.
EMPLOYEE_CACHE_TTL_SECONDS=60


# ------------------------------------------------------------------
# Employee data source
# ------------------------------------------------------------------

# ejadah_api : live HR APIs (the only valid production value)
# local_db   : seeded demo SQLite, for offline development
EMPLOYEE_DATA_SOURCE=ejadah_api


# ------------------------------------------------------------------
# LLM
# ------------------------------------------------------------------

# Prompts contain the employee's own HR data, which makes the model
# provider a data processor. Keep this key out of source control and
# prefer a zero-retention agreement.
GROQ_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1

# Larger model answers; smaller model classifies and rewrites.
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_REWRITE_MODEL=openai/gpt-oss-20b

LLM_ANSWER_TEMPERATURE=0.3
LLM_ANSWER_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60


# ------------------------------------------------------------------
# RAG
# ------------------------------------------------------------------

VECTOR_DB_PATH=data/vector_db
VECTOR_DB_COLLECTION=hr_knowledge_base
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3
KNOWLEDGE_BASE_PATH=data/company_info


# ------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------

CHAT_MEMORY_DB_PATH=data/chat_memory.db
HR_QUERY_DB_PATH=data/hr_queries.db
LOCAL_EMPLOYEE_DB_PATH=data/hr_employee.db

HISTORY_MESSAGE_LIMIT=20

# Transcripts are personal data. Applied at startup and by
# POST /api/admin/purge-memory. 0 disables the purge.
MEMORY_RETENTION_DAYS=90


# ------------------------------------------------------------------
# Abuse protection
# ------------------------------------------------------------------

RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUESTION_LENGTH=1000

# Shared secret for GET /ready and POST /api/admin/purge-memory.
# Leave empty to disable those endpoints entirely (they 404).
ADMIN_API_KEY=
